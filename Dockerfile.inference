FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir .
RUN useradd --create-home service
USER service
ENV PYTHONPATH=/app/src
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "tse.public_api:create_public_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
