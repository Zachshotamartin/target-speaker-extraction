{
  "schema_version": 1,
  "status": "active",
  "experiment": "v3-continuation-cosine",
  "seed": 168,
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "crop_seconds": 4.0,
    "reference_seconds": 5.0
  },
  "data": {
    "protocol": "custom-librispeech-tse-v1",
    "training_source": "LibriSpeech/train-clean-100",
    "development_source": "LibriSpeech/dev-clean",
    "test_source": "LibriSpeech/train-clean-100/reserved-identities",
    "pilot_speakers_target": 231,
    "minimum_utterances_per_speaker": 20,
    "mixtures_on_demand": true,
    "distinct_reference_utterance": true,
    "prefer_different_reference_chapter": true,
    "target_to_interferer_db": [
      -5.0,
      5.0
    ],
    "overlap_fraction": 1.0,
    "target_present": true
  },
  "model": {
    "family": "reference_conditioned_stft_tcn",
    "weights": "project_checkpoint",
    "encoder_channels": 257,
    "encoder_kernel_samples": 32,
    "encoder_stride_samples": 16,
    "bottleneck_channels": 96,
    "hidden_channels": 192,
    "skip_channels": 96,
    "temporal_kernel": 3,
    "dilations": [
      1,
      2,
      4,
      8,
      16,
      32
    ],
    "repeats": 3,
    "conditioning": "feature_wise_affine",
    "mask_activation": "sigmoid",
    "stft_fft_samples": 512,
    "stft_hop_samples": 128,
    "causal": false,
    "parameter_budget": 4000000,
    "reference_encoder": {
      "channels": 128,
      "kernel_samples": 160,
      "stride_samples": 80,
      "dilations": [
        1,
        2,
        4
      ],
      "pooling": "masked_mean_std",
      "embedding_dim": 128,
      "shared_with_mixture_encoder": false
    }
  },
  "training": {
    "optimizer": "adamw",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "microbatch_size": 4,
    "gradient_accumulation": 2,
    "gradient_clip_norm": 5.0,
    "max_optimizer_updates": 25000,
    "validation_interval_updates": 500,
    "precision": "float32",
    "learning_rate_schedule": "cosine",
    "scheduler_patience_validations": 6,
    "scheduler_factor": 0.5,
    "minimum_learning_rate": 3e-05,
    "num_workers": 0,
    "retain_checkpoints": [
      "best",
      "latest"
    ],
    "schedule_decay_updates": 5000
  },
  "loss": {
    "primary": "negative_si_sdr",
    "epsilon": 1e-08,
    "mask_padding": true,
    "zero_mean": true,
    "speaker_classification_weight": 0.2,
    "speaker_logit_scale": 10.0,
    "waveform_weight": 0.5,
    "spectral_weight": 0.5,
    "spectral_fft_sizes": [
      256,
      512,
      1024
    ],
    "absent_target_si_sdr": "unsupported"
  },
  "augmentation": {
    "reference_enabled": false,
    "mixture_noise_enabled": false,
    "independent_random_streams": true
  },
  "evaluation": {
    "development_cases_target": 80,
    "final_test_cases_target": 1000,
    "mixture_seconds": 4.0,
    "reference_seconds": 5.0,
    "confusion_margin_db": 3.0,
    "bootstrap_target_speaker_clusters": true,
    "bootstrap_replicates": 1000,
    "training_seeds_final_target": 3
  },
  "runtime": {
    "preferred_device": "mps",
    "cpu_path_required": true,
    "allow_implicit_cpu_fallback_in_benchmarks": false,
    "benchmark_warmup_steps": 20,
    "benchmark_measured_steps": 100
  },
  "resources": {
    "minimum_free_disk_gib": 15.0,
    "persistent_artifact_budget_gib": 20.0,
    "process_rss_target_gib": 10.0
  },
  "inference": {
    "mode": "offline",
    "maximum_mixture_seconds": 60.0,
    "minimum_reference_seconds": 3.0,
    "maximum_reference_seconds": 10.0,
    "input_formats": [
      "wav",
      "flac"
    ],
    "maximum_concurrent_extractions": 1,
    "report_confidence": false
  }
}
